<mxfile host="app.diagrams.net"><diagram name="Healthcare Fraud Detection Architecture"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Healthcare Claims Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="400" y="40" width="300" height="60" as="geometry"/></mxCell><mxCell id="3" value="Data Preprocessing&#xa;Cleaning • Missing Values • Encoding • Normalization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="400" y="130" width="300" height="70" as="geometry"/></mxCell><mxCell id="4" value="Heterogeneous Graph G(V,E,X)&#xa;Patient • Department • Medicine • Time&#xa;6 relationship types" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="400" y="230" width="300" height="75" as="geometry"/></mxCell><mxCell id="5" value="Topology View&#xa;Original Relationships" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="60" y="350" width="220" height="65" as="geometry"/></mxCell><mxCell id="6" value="Feature View&#xa;KNN + Cosine Similarity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="390" y="350" width="220" height="65" as="geometry"/></mxCell><mxCell id="7" value="Semantic View&#xa;P-K-P • P-T-P • P-M-P&#xa;Common Path Sampling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="720" y="350" width="220" height="65" as="geometry"/></mxCell><mxCell id="8" value="Multi-View GCN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="390" y="455" width="300" height="55" as="geometry"/></mxCell><mxCell id="9" value="Specific GCN&#xa;ZT • ZF • ZS&#xa;O